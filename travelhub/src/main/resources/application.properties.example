spring.application.name=travelhub
spring.datasource.url=jdbc:mysql://localhost:3306/travelhub
spring.datasource.username=seu_usuario
spring.datasource.password=sua_senha
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

server.port=8000
# stateless (JWT) - nao usamos sessao de servidor, entao nao ha motivo pra persistir sessao em disco
# (evita um bug conhecido de checagem de dono de pasta em AppData\Local\Temp no Windows)
server.servlet.session.persistent=false

# upload de foto de perfil
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB

jwt.secret=${JWT_SECRET}
jwt.expiration=86400000
