spring.application.name=veyra
spring.datasource.url=jdbc:mysql://localhost:3306/travelhub
# use um usuario dedicado, com privilegios so no schema travelhub — nunca o root
# do MySQL. Exemplo de criacao:
#   CREATE USER 'travelhub_app'@'%' IDENTIFIED BY 'senha_forte_aqui';
#   GRANT ALL PRIVILEGES ON travelhub.* TO 'travelhub_app'@'%';
# DB_PASSWORD salva como variavel de ambiente, mesmo padrao do JWT_SECRET.
spring.datasource.username=travelhub_app
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# validate (nao "update"): o Hibernate so confere se as entidades batem com o
# schema, nunca mais altera o banco sozinho — toda mudanca de schema passa por
# uma migration do Flyway (src/main/resources/db/migration)
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# baseline-on-migrate=true: necessario so se voce ja tinha um banco criado antes
# do Flyway existir nesse projeto (registra a V1 como "ja aplicada" sem executar).
# Num banco novo do zero, pode deixar false — a V1 roda normalmente.
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1

server.port=8000
# stateless (JWT) - nao usamos sessao de servidor, entao nao ha motivo pra persistir sessao em disco
# (evita um bug conhecido de checagem de dono de pasta em AppData\Local\Temp no Windows)
server.servlet.session.persistent=false

# upload de foto de perfil
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB

jwt.secret=${JWT_SECRET}
jwt.expiration=86400000

# origens permitidas por CORS, separadas por virgula. Em producao, trocar pela
# URL real do frontend publicado (ex: https://travelhub.exemplo.com)
app.cors.allowed-origins=http://localhost:5173

# URL do frontend publicado — usada para montar o link de redefinicao de senha
app.frontend-url=http://localhost:5173

# se o login bloqueia usuarios com email nao confirmado (403 "email_nao_verificado").
# Deixe "true" (padrao) se o app for ficar aberto pro publico geral. Para um grupo
# pequeno e conhecido (sem provedor de email configurado ainda), pode usar "false"
# sem problema — o risco que essa trava evita so importa mesmo com estranhos.
app.auth.exigir-verificacao-email=true

# --- Envio de email: escolha UMA das opcoes abaixo ---
#
# Opcao A) Gmail SMTP — bom pra dev local / teste, entrega em caixa de entrada
# real sem precisar de dominio proprio. GMAIL_APP_PASSWORD e uma "senha de app"
# gerada em myaccount.google.com/apppasswords (exige verificacao em 2 etapas
# ativada na conta) — NAO e a senha normal do Gmail.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=seu_email@gmail.com
spring.mail.password=${GMAIL_APP_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
app.mail.from=seu_email@gmail.com
#
# Opcao B) Resend (https://resend.com) — free tier sem cartao, mas SEM dominio
# proprio verificado (aba Domains no painel deles) ele so entrega em enderecos
# sinteticos de teste (@resend.dev), nunca em caixa de entrada real. Use essa
# opcao quando for pra producao, com um dominio de verdade verificado la.
# spring.mail.host=smtp.resend.com
# spring.mail.port=587
# spring.mail.username=resend
# spring.mail.password=${RESEND_API_KEY}
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# app.mail.from=verificado@seu-dominio.com
